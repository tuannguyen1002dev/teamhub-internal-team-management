generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String      @id @default(cuid())
  email       String      @unique
  fullname    String?
  username    String?
  password    String?     @map("hashed_password")
  dateOfBirth DateTime?
  phoneNumber String?
  address     String?
  gender      UserGender?
  role        UserRole
  permissions String[]    @default(["READ"])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Invitation {
  id         String           @id @default(cuid())
  email      String           @unique
  token      String           @unique
  invLink    String           @unique
  status     InvitationStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  acceptedAt DateTime?
  createBy   String           @default("admin")
}

enum UserGender {
  Male
  Female
  Others
}

enum UserRole {
  USER
  ADMIN
  OPERATOR
  SUDO
}

enum UserPermission {
  READ
  WRITE
  DELETE
  EXECUTE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPRIRED
}
