generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id          String        @id @default(cuid())
  email       String        @unique
  fullname    String?
  username    String?
  password    String?       @map("hashed_password")
  status      AccountStatus @default(SUSPENDED)
  dateofbirth DateTime?
  phone       String?
  address     String?
  gender      GenderOption?
  role        AccountRole   @default(USER)
  permissions String[]      @default(["READ", "WRITE", "UPDATE", "DELETE"])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum AccountRole {
  ADMIN
  USER
  OPERATOR
}

enum GenderOption {
  MALE
  FEMALE
  OTHER
}

// !___________________________________________________________________

model Invitation {
  id         String           @id @default(cuid())
  email      String           @unique
  token      String           @unique
  invLink    String           @unique
  status     InvitationStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  acceptedAt DateTime?
  createBy   String           @default("admin")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPRIRED
}
